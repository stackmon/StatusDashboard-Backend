# Example for environment variables
SD_DB=postgresql://pg:pass@localhost:5432/status_dashboard
SD_CACHE=internal
SD_LOG_LEVEL=devel
SD_PORT=8000

# OIDC resource server (Zitadel). The issuer must expose
# /.well-known/openid-configuration; ClientID is the audience every accepted
# token must be issued to.
SD_OIDC_ISSUER=https://zitadel.example.com
SD_OIDC_CLIENT_ID=your-zitadel-project-id
SD_OIDC_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# Optional: claim to use as the display user name. Zitadel access tokens do not
# carry preferred_username unless it is added by an action.
# SD_OIDC_USERNAME_CLAIM=preferred_username

# RBAC roles, matched against the role names carried by the roles claim.
# SD_RBAC_ROLES_ADMINS is mandatory.
SD_RBAC_ROLES_CREATORS=sd_creators
SD_RBAC_ROLES_OPERATORS=sd_operators
SD_RBAC_ROLES_ADMINS=sd_admins
# Optional: machine principals that may only create system incidents.
# SD_RBAC_ROLES_REPORTERS=sd_reporters
